datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  name                String
  role                String               // patient / doctor / admin
  createdAt           DateTime             @default(now()) @map("created_at")
  appointmentsPatient Appointment[]        @relation("PatientAppointments")
  appointmentsDoctor  Appointment[]        @relation("DoctorAppointments")
  doctorProfile       DoctorProfile?
  medicationReminders MedicationReminder[]
  slotHolds           SlotHold[]

  @@map("users")
}

model DoctorProfile {
  id                 Int           @id @default(autoincrement())
  userId             Int           @unique @map("user_id")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation     String
  workingHoursStart  String        @map("working_hours_start") // e.g. "09:00"
  workingHoursEnd    String        @map("working_hours_end")   // e.g. "17:00"
  slotDuration       Int           @map("slot_duration")       // in minutes
  leaves             DoctorLeave[]

  @@map("doctor_profiles")
}

model DoctorLeave {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  leaveDate       String        @map("leave_date") // YYYY-MM-DD

  @@unique([doctorProfileId, leaveDate])
  @@map("doctor_leaves")
}

model Appointment {
  id                     Int                  @id @default(autoincrement())
  patientId              Int                  @map("patient_id")
  patient                User                 @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               Int                  @map("doctor_id")
  doctor                 User                 @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate        String               @map("appointment_date") // YYYY-MM-DD
  startTime              String               @map("start_time")       // HH:MM
  endTime                String               @map("end_time")         // HH:MM
  status                 String               @default("booked")       // held / booked / cancelled / completed
  googleCalendarEventId  String?              @map("google_calendar_event_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  symptomForm            SymptomForm?
  preVisitSummary        PreVisitSummary?
  postVisitNote          PostVisitNote?
  prescription           Prescription?
  medicationReminders    MedicationReminder[]

  @@unique([doctorId, appointmentDate, startTime])
  @@index([doctorId, appointmentDate])
  @@map("appointments")
}

model SlotHold {
  id              Int      @id @default(autoincrement())
  doctorId        Int      @map("doctor_id")
  doctor          User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate String   @map("appointment_date")
  startTime       String   @map("start_time")
  holdToken       String   @map("hold_token")
  expiresAt       BigInt   @map("expires_at") // Epoch millisecond timestamp

  @@unique([doctorId, appointmentDate, startTime])
  @@map("slot_holds")
}

model SymptomForm {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  symptoms      String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("symptom_forms")
}

model PreVisitSummary {
  id                 Int         @id @default(autoincrement())
  appointmentId      Int         @unique @map("appointment_id")
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  urgency            String      // Low / Medium / High / Pending
  chiefComplaint     String      @map("chief_complaint")
  suggestedQuestions String      @map("suggested_questions") // JSON string representation of string[]

  @@map("pre_visit_summaries")
}

model PostVisitNote {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  notes         String

  @@map("post_visit_notes")
}

model Prescription {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  drug          String
  dosage        String
  frequency     String
  duration      String

  @@map("prescriptions")
}

model MedicationReminder {
  id             Int         @id @default(autoincrement())
  appointmentId  Int         @map("appointment_id")
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      Int         @map("patient_id")
  patient        User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName String      @map("medication_name")
  frequency      String
  lastSent       DateTime?   @map("last_sent")
  nextSend       BigInt      @map("next_send") // Epoch millisecond timestamp
  status         String      @default("active") // active / completed

  @@map("medication_reminders")
}

model NotificationLog {
  id             Int      @id @default(autoincrement())
  recipientEmail String   @map("recipient_email")
  type           String   // email / calendar
  subject        String
  body           String
  status         String   @default("pending") // pending / sent / failed
  retryCount     Int      @default(0) @map("retry_count")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("notification_logs")
}
